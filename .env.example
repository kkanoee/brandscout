# BrandScout — configuration (copier vers .env)
# Toutes les clés sont optionnelles : sans clé, le module concerné bascule en
# mode fixtures/mock pour que le pipeline tourne hors-ligne (voir BRANDSCOUT_MODE).

# --- Mode global ---------------------------------------------------------------
# live     : appels reels (necessite les cles ci-dessous)
# fixtures : connecteurs + LLM mockes, donnees locales deterministes (aucune cle)
# auto     : live si les cles existent, sinon fixtures (defaut)
BRANDSCOUT_MODE=auto

# --- Routage LLM 2 etages (ADR-0002) -------------------------------------------
# Etage "mecanique" : modele gratuit via OpenRouter (owl-alpha en v1).
# L'id de modele est une CONFIG, jamais code en dur.
OPENROUTER_API_KEY=
LLM_MECHANICAL_MODEL=openrouter/owl-alpha

# Etage "jugement" : modele frontier via Anthropic (Claude Opus 4.8).
ANTHROPIC_API_KEY=
LLM_JUDGMENT_MODEL=claude-opus-4-8

# Backend du jugement : auto | anthropic | openrouter | mock
#   auto       : Anthropic si cle presente, sinon OpenRouter (gratuit), sinon mock
#   openrouter : FORCE le jugement sur un modele gratuit -> cout zero. Sans risque
#                car le tier de Confidence est calcule par le code, pas le LLM.
LLM_JUDGMENT_PROVIDER=auto
LLM_JUDGMENT_OPENROUTER_MODEL=openrouter/owl-alpha

# --- Connecteurs ---------------------------------------------------------------
# YouTube Data API v3 (quota 10k u/jour, gratuit).
YOUTUBE_API_KEY=

# Reddit : app "script" (https://www.reddit.com/prefs/apps). OAuth client creds.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=brandscout/1.0 (by /u/yourname)

# --- X / Reddit via CLI-backend NON-OFFICIEL (ADR-0008) ------------------------
# Acces non-officiel via CLIs tiers (twitter-cli / rdt-cli) utilisant TA session
# connectee. Risque ToS + ban -> utilise un compte BURNER. A installer (1 paquet
# par commande) :  pipx install twitter-cli   puis   pipx install rdt-cli
# Actif uniquement en BRANDSCOUT_MODE=live ; sinon fixtures (offline).
REDDIT_BACKEND=official          # official (OAuth API) | cli (rdt-cli)
X_CLI_BIN=twitter                # binaire twitter-cli
REDDIT_CLI_BIN=rdt               # binaire rdt-cli
# Auth des CLIs (2 options) :
#  A) extraction auto des cookies du navigateur ou le compte burner est connecte
#     (rdt: `rdt login` ; twitter: automatique). Peut echouer selon navigateur/OS.
#  B) fallback manuel (utilise ici) : coller les cookies de session du burner.
#     - twitter-cli lit ces 2 variables (cookies auth_token + ct0 de x.com) :
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
#     - rdt-cli lit ~/.config/rdt-cli/credential.json au format {"cookies":{...}}
#       (au minimum le cookie reddit_session). Fichier hors repo, jamais commite.

# --- Enveloppe d'un Run (defauts, configurables) -------------------------------
RUN_WINDOW_MONTHS=6
RUN_VOLUME_CAP=500
PREFILTER_MIN_LENGTH=15

# --- Seuils de Confidence (ADR-0004, ajustables) -------------------------------
CONF_MIN_AUTHORS=3
CONF_FACT_MIN_SOURCES=2

# --- Serveur web ---------------------------------------------------------------
PORT=4317
DB_PATH=data/brandscout.sqlite

# --- Piste GEO / source IA (ADR-0007, prototype) -------------------------------
# Modeles d'IA a sonder en LIVE (ids OpenRouter, separes par des virgules).
# A adapter aux modeles que tu veux mesurer. Sans --live, le prototype tourne
# sur fixtures (offline, gratuit) : node src/geo.ts "Chart Fanatics"
GEO_MODELS=openai/gpt-4o-mini,google/gemini-flash-1.5,x-ai/grok-2-1212
